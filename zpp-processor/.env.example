# Configurações MongoDB
MONGO_URI=mongodb://localhost:27017
DB_NAME=amg_data

# Configurações do serviço
PORT=5002
LOG_LEVEL=INFO

# Diretórios de dados (volumes Docker)
BASE_DATA_DIR=/data

# Configurações de processamento
BATCH_SIZE=1000

# Configurações de agendamento automático
SCHEDULER_INTERVAL_SECONDS=3600

# Regra de campo de referência para cálculo do mês (fim | inicio)
MONTH_BOUNDARY_RULE=fim

# URL interna do webapp para validação de sessão
WEBAPP_INTERNAL_URL=http://webapp:8050
