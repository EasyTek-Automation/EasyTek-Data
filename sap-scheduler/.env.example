# sap-scheduler daemon — .env.example (DS-04 + IM-D4)
# Copiar pra .env e preencher antes do primeiro run.
# Documentado em DS-04 (campos) + DS-05 (deploy).

# === Obrigatorios ===
# URI completa do Mongo do AMG (mesmo do webapp).
MONGO_URI=mongodb://<host>:27017/?directConnection=true
# Nome do database (mesmo do webapp).
DB_NAME=Cluster-EasyTek
# Caminho absoluto Windows do input/ do zpp-processor (descoberto via docker inspect — VF-06-12).
PASTA_INPUT_ZPP_PROCESSOR=C:\amg-share\zpp-input

# === Opcionais (defaults aceitaveis pra producao) ===
SAP_JOBS_COLLECTION=sap_jobs
SAP_JOBS_TIPOS_SUPORTADOS=zppprd,zpp_nt0001
POLLING_INTERVAL_SEGUNDOS=30
HEARTBEAT_INTERVAL_SEGUNDOS=3600
LOG_LEVEL=INFO
LOG_BACKUP_COUNT=30

# === Modo MOCK_SAP (IM-E6) — testes E2E locais sem SAPlogon ===
# Quando true, executor_sap copia .xlsx aleatorio de AUDIT_MAIO_DIR em vez de
# chamar zpp_gridcap.export_grid. Usar SOMENTE em dev/CI.
MOCK_SAP=false
# Pasta com .xlsx reais coletados na campanha 2026-05-24 (fallback do mock).
AUDIT_MAIO_DIR=
