<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>SAP Job Scheduler — daemon Python 32-bit que executa jobs SAP via GUI Scripting</Description>
    <Author>%USERNAME%</Author>
  </RegistrationInfo>
  <!--
    Bloco I A-02: Task Scheduler NAO expande variaveis de ambiente em <UserId>.
    Antes de registrar, substituir %USERDOMAIN%\%USERNAME% pelo valor LITERAL
    (ex: MADRID\cmanutencao). RUNBOOK-instalacao.md TAREFA 6 documenta o procedimento.
  -->
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>%USERDOMAIN%\%USERNAME%</UserId>
      <Repetition>
        <Interval>PT1M</Interval>
        <Duration>P9999D</Duration>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>%USERDOMAIN%\%USERNAME%</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>5</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <!--
        Bloco I A-01: usa launcher.vbs (wscript) em vez de python.exe direto.
        pythonw.exe nao funciona porque zpp_gridcap.export_grid faz print()
        e pythonw tem stdout=None. wscript //B //Nologo + Run(_, 0, True)
        executa python.exe (com stdout) em janela oculta + bloqueante
        (preserva single-instance + LogonTrigger repeat 1min).
      -->
      <Command>C:\Windows\System32\wscript.exe</Command>
      <Arguments>//B //Nologo "%USERPROFILE%\sap-scheduler\launcher.vbs"</Arguments>
      <WorkingDirectory>%USERPROFILE%\sap-scheduler</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
